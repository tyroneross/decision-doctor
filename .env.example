# Decision Doctor — env vars
# Verify in secrets-vault before populating; see decision-doctor-prd.md §10 + §14.

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require
DATABASE_URL_APP=postgresql://app_user:pass@ep-xxx.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require

# --- Better Auth ---
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3006

# --- Google OAuth sign-in (optional until configured in Google Cloud Console) ---
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
AUTH_FROM_EMAIL=Decision Doctor <auth@decisiondoctor.app>

# --- LLM (Groq) ---
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b
AI_SUMMARIZE_MODEL=llama-3.3-70b-versatile
KG_EXTRACT_MODEL=llama-3.3-70b-versatile

# --- OpenAI retrieval / embeddings ---
OPENAI_API_KEY=sk_xxx
OPENAI_RERANK_MODEL=gpt-4o-mini

# --- Recommendation/detail URL generation ---
NEXT_PUBLIC_APP_URL=http://localhost:3006

# --- Vercel preview toolbar / feedback ---
VERCEL_PREVIEW_FEEDBACK_ENABLED=1

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Rate limiter (optional in dev; required in prod) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Search/rerank tuning (optional) ---
BGE_ENABLED=false
BGE_RERANK_URL=
BGE_MODEL=Xenova/bge-reranker-base
BGE_FORCE_TIMEOUT=false
RECALL_TARGET=0.91
RECALL_TARGET_SMB=0.70

# --- Worker queue tuning (optional) ---
PORT=8080
CRON_PROBE=0
EMBED_BATCH=1
AI_SUMMARIZE_BATCH=1
KG_EXTRACT_BATCH=1

# --- Feature flags (optional) ---
FEATURE_FULL_VALIDATION=true
FEATURE_ASYNC_PROCESSING=false
FEATURE_CACHING=false
FEATURE_RATE_LIMITING=true

# --- Local destructive scripts (optional) ---
CONFIRM_RESET=0

# --- Historical backfill guardrails (optional) ---
BACKFILL_COST_PER_DOC_USD=0.01
BACKFILL_MAX_TOTAL_USD=35
BACKFILL_MAX_TOTAL_DOCS=2500
BACKFILL_DRY_RUN=1
BACKFILL_FORCE=0
