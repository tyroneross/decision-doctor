{
  "app-guide-capacity": {
    "target": "app/(app)/app/page.tsx",
    "url": "http://127.0.0.1:3101/app/guide?question=I%20am%20exhausted%20and%20my%20waitlist%20keeps%20growing.%20Should%20I%20keep%20accepting%20new%20intakes%3F&aiMaturity=new_to_ai&mockup=chat-guide-v18",
    "tests": [
      {
        "name": "Guide a messy capacity question into the structured intake.",
        "steps": [
          {
            "screenshot": "app-guide-capacity-result"
          },
          {
            "assert": {
              "text": "Capacity decision"
            }
          },
          {
            "wait": "Start Capacity intake"
          },
          {
            "click": "Start Capacity intake"
          },
          {
            "wait": "Capacity decision"
          },
          {
            "assert": {
              "text": "No PHI is needed"
            }
          },
          {
            "screenshot": "app-guide-capacity-intake"
          }
        ]
      }
    ]
  },
  "app-guide-ai-start": {
    "target": "app/(app)/app/page.tsx",
    "url": "http://127.0.0.1:3101/app?mockup=chat-guide-v18",
    "tests": [
      {
        "name": "Show the AI insertion scan start state.",
        "steps": [
          {
            "screenshot": "app-guide-ai-start"
          },
          {
            "assert": {
              "text": "Prioritize where AI should help."
            }
          },
          {
            "assert": {
              "text": "List what wastes time."
            }
          },
          {
            "assert": {
              "text": "Rank work"
            }
          }
        ]
      }
    ]
  },
  "app-guide-ai-result": {
    "target": "app/(app)/app/page.tsx",
    "url": "http://127.0.0.1:3101/app/guide?question=Where%20should%20I%20start%20using%20AI%20to%20reduce%20follow-up%20work%20and%20free%20two%20hours%20each%20week%3F&aiMaturity=new_to_ai&mockup=chat-guide-v18",
    "tests": [
      {
        "name": "Guide a non-template AI workflow question without forcing a template.",
        "steps": [
          {
            "screenshot": "app-guide-ai-result"
          },
          {
            "assert": {
              "text": "AI insertion priority framework"
            }
          },
          {
            "assert": {
              "text": "AI insertion scorer skill"
            }
          },
          {
            "assert": {
              "text": "Starter prompt, skill, and plugin"
            }
          },
          {
            "assert": {
              "text": "Plugin starter"
            }
          },
          {
            "assert": {
              "text": "No PHI is needed"
            }
          }
        ]
      }
    ]
  }
}
