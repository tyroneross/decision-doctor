{
  "name": "decision-doctor",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent decision engine for solo healthcare practitioners. See decision-doctor-prd.md.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && pnpm db:rls",
    "db:push": "drizzle-kit push && pnpm db:rls",
    "db:rls": "node -e \"const{execSync}=require('child_process');require('dotenv').config({path:'.env.local'});execSync('psql \\\"'+process.env.DATABASE_URL+'\\\" -f drizzle/0001_enable_rls.sql',{stdio:'inherit'})\"",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.0",
    "@neondatabase/serverless": "^0.10.0",
    "@sentry/nextjs": "^10.0.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "better-auth": "^1.6.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.36.0",
    "groq-sdk": "^0.7.0",
    "lucide-react": "^0.460.0",
    "next": "^16.0.0",
    "pino": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
